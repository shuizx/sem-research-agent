{
  "$defs": {
    "CodeLinkConfidence": {
      "description": "Confidence of a paper-to-code association.",
      "enum": [
        "OFFICIAL_HIGH",
        "PROBABLE_MEDIUM",
        "UNVERIFIED",
        "CONTRADICTED"
      ],
      "title": "CodeLinkConfidence",
      "type": "string"
    },
    "ContentHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "NonBlankStr": {
      "minLength": 1,
      "type": "string"
    },
    "OpaqueId": {
      "minLength": 1,
      "type": "string"
    },
    "ProvenanceRef": {
      "additionalProperties": false,
      "description": "Provenance for a retrieved or generated domain record.",
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentHash"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_artifact_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieved_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "$ref": "#/$defs/NonBlankStr"
        },
        "source_type": {
          "enum": [
            "provider",
            "api",
            "user",
            "generated"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankStr"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "source_type",
        "source_id",
        "retrieved_at"
      ],
      "title": "ProvenanceRef",
      "type": "object"
    },
    "ReasonCode": {
      "pattern": "^[A-Z0-9]+(?:_[A-Z0-9]+){2,}$",
      "type": "string"
    },
    "UTCDateTime": {
      "format": "date-time",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Auditable evidence connecting a paper candidate to a repository.",
  "properties": {
    "confidence": {
      "$ref": "#/$defs/CodeLinkConfidence"
    },
    "evidence_id": {
      "$ref": "#/$defs/OpaqueId"
    },
    "evidence_type": {
      "enum": [
        "paper_link",
        "project_page",
        "author_repo",
        "readme",
        "search"
      ],
      "title": "Evidence Type",
      "type": "string"
    },
    "paper_id": {
      "$ref": "#/$defs/OpaqueId"
    },
    "provenance": {
      "$ref": "#/$defs/ProvenanceRef"
    },
    "rationale_codes": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "title": "Rationale Codes",
      "type": "array"
    },
    "repository_url": {
      "$ref": "#/$defs/NonBlankStr"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "verified_at": {
      "$ref": "#/$defs/UTCDateTime"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "paper_id",
    "repository_url",
    "evidence_type",
    "confidence",
    "provenance",
    "verified_at"
  ],
  "title": "CodeLinkEvidence",
  "type": "object"
}
