{
  "$defs": {
    "ContentHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "GitCommitSha": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "HumanText": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "LicenseStatus": {
      "description": "Repository license policy outcome.",
      "enum": [
        "ALLOWLISTED",
        "REVIEW_REQUIRED",
        "DENIED",
        "UNKNOWN"
      ],
      "title": "LicenseStatus",
      "type": "string"
    },
    "NonBlankStr": {
      "minLength": 1,
      "type": "string"
    },
    "NonNegativeInt": {
      "minimum": 0,
      "type": "integer"
    },
    "OpaqueId": {
      "minLength": 1,
      "type": "string"
    },
    "ProvenanceRef": {
      "additionalProperties": false,
      "description": "Provenance for a retrieved or generated domain record.",
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentHash"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_artifact_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieved_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "$ref": "#/$defs/NonBlankStr"
        },
        "source_type": {
          "enum": [
            "provider",
            "api",
            "user",
            "generated"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankStr"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "source_type",
        "source_id",
        "retrieved_at"
      ],
      "title": "ProvenanceRef",
      "type": "object"
    },
    "ReasonCode": {
      "pattern": "^[A-Z0-9]+(?:_[A-Z0-9]+){2,}$",
      "type": "string"
    },
    "RiskFinding": {
      "additionalProperties": false,
      "description": "One static-analysis finding; it does not itself authorize an action.",
      "properties": {
        "category": {
          "$ref": "#/$defs/ReasonCode"
        },
        "description": {
          "$ref": "#/$defs/HumanText"
        },
        "finding_id": {
          "$ref": "#/$defs/OpaqueId"
        },
        "location_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankStr"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule_id": {
          "$ref": "#/$defs/NonBlankStr"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/SeverityLevel"
        }
      },
      "required": [
        "schema_version",
        "finding_id",
        "rule_id",
        "category",
        "severity",
        "description"
      ],
      "title": "RiskFinding",
      "type": "object"
    },
    "SeverityLevel": {
      "description": "Unified severity vocabulary for labels, gaps, and findings.",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "SeverityLevel",
      "type": "string"
    },
    "UTCDateTime": {
      "format": "date-time",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Repository metadata fixed to a complete verified Git commit SHA.",
  "properties": {
    "analysis_artifact_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/OpaqueId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "analyzed_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/UTCDateTime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "archive_artifact_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/OpaqueId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "canonical_url": {
      "$ref": "#/$defs/NonBlankStr"
    },
    "commit_sha": {
      "$ref": "#/$defs/GitCommitSha"
    },
    "default_branch": {
      "anyOf": [
        {
          "$ref": "#/$defs/NonBlankStr"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "framework": {
      "anyOf": [
        {
          "$ref": "#/$defs/NonBlankStr"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "languages": {
      "additionalProperties": {
        "$ref": "#/$defs/NonNegativeInt"
      },
      "propertyNames": {
        "$ref": "#/$defs/NonBlankStr"
      },
      "title": "Languages",
      "type": "object"
    },
    "license_spdx": {
      "anyOf": [
        {
          "$ref": "#/$defs/NonBlankStr"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "license_status": {
      "$ref": "#/$defs/LicenseStatus"
    },
    "name": {
      "$ref": "#/$defs/NonBlankStr"
    },
    "owner": {
      "$ref": "#/$defs/NonBlankStr"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceRef"
      },
      "title": "Provenance",
      "type": "array"
    },
    "provider": {
      "enum": [
        "GITHUB",
        "LOCAL_FIXTURE"
      ],
      "title": "Provider",
      "type": "string"
    },
    "repository_id": {
      "$ref": "#/$defs/OpaqueId"
    },
    "risk_findings": {
      "items": {
        "$ref": "#/$defs/RiskFinding"
      },
      "title": "Risk Findings",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "repository_id",
    "canonical_url",
    "provider",
    "owner",
    "name",
    "commit_sha",
    "license_status"
  ],
  "title": "RepositorySnapshot",
  "type": "object"
}
