{
  "$defs": {
    "AuthorRef": {
      "additionalProperties": false,
      "description": "A paper author and optional external identity reference.",
      "properties": {
        "external_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "$ref": "#/$defs/NonBlankStr"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "name"
      ],
      "title": "AuthorRef",
      "type": "object"
    },
    "ContentHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "FiniteFloat": {
      "type": "number"
    },
    "HumanText": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "NonBlankStr": {
      "minLength": 1,
      "type": "string"
    },
    "OpaqueId": {
      "minLength": 1,
      "type": "string"
    },
    "ProvenanceRef": {
      "additionalProperties": false,
      "description": "Provenance for a retrieved or generated domain record.",
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentHash"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_artifact_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieved_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "$ref": "#/$defs/NonBlankStr"
        },
        "source_type": {
          "enum": [
            "provider",
            "api",
            "user",
            "generated"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankStr"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "source_type",
        "source_id",
        "retrieved_at"
      ],
      "title": "ProvenanceRef",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "description": "Stable reason code with optional bounded human explanation.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "message": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "code"
      ],
      "title": "Reason",
      "type": "object"
    },
    "ReasonCode": {
      "pattern": "^[A-Z0-9]+(?:_[A-Z0-9]+){2,}$",
      "type": "string"
    },
    "StrictBoolean": {
      "type": "boolean"
    },
    "UTCDateTime": {
      "format": "date-time",
      "type": "string"
    },
    "UnitInterval": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    }
  },
  "additionalProperties": false,
  "description": "Normalized candidate paper with provenance and bounded relevance data.",
  "properties": {
    "abstract_artifact_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/OpaqueId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authors": {
      "items": {
        "$ref": "#/$defs/AuthorRef"
      },
      "title": "Authors",
      "type": "array"
    },
    "canonical_title": {
      "$ref": "#/$defs/HumanText"
    },
    "exclusion_reasons": {
      "items": {
        "$ref": "#/$defs/Reason"
      },
      "title": "Exclusion Reasons",
      "type": "array"
    },
    "external_ids": {
      "additionalProperties": {
        "$ref": "#/$defs/NonBlankStr"
      },
      "propertyNames": {
        "$ref": "#/$defs/NonBlankStr"
      },
      "title": "External Ids",
      "type": "object"
    },
    "first_published_at": {
      "$ref": "#/$defs/UTCDateTime"
    },
    "inclusion_reasons": {
      "items": {
        "$ref": "#/$defs/Reason"
      },
      "title": "Inclusion Reasons",
      "type": "array"
    },
    "method_tags": {
      "items": {
        "$ref": "#/$defs/NonBlankStr"
      },
      "title": "Method Tags",
      "type": "array"
    },
    "paper_id": {
      "$ref": "#/$defs/OpaqueId"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceRef"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "relevance_score": {
      "$ref": "#/$defs/UnitInterval"
    },
    "request_id": {
      "$ref": "#/$defs/OpaqueId"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "score_components": {
      "additionalProperties": {
        "$ref": "#/$defs/FiniteFloat"
      },
      "propertyNames": {
        "$ref": "#/$defs/NonBlankStr"
      },
      "title": "Score Components",
      "type": "object"
    },
    "selected": {
      "$ref": "#/$defs/StrictBoolean",
      "default": false
    },
    "task_tags": {
      "items": {
        "$ref": "#/$defs/NonBlankStr"
      },
      "title": "Task Tags",
      "type": "array"
    },
    "updated_at_external": {
      "anyOf": [
        {
          "$ref": "#/$defs/UTCDateTime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "urls": {
      "additionalProperties": {
        "$ref": "#/$defs/NonBlankStr"
      },
      "propertyNames": {
        "$ref": "#/$defs/NonBlankStr"
      },
      "title": "Urls",
      "type": "object"
    },
    "venue": {
      "anyOf": [
        {
          "$ref": "#/$defs/HumanText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "paper_id",
    "request_id",
    "canonical_title",
    "first_published_at",
    "relevance_score",
    "provenance"
  ],
  "title": "PaperCandidate",
  "type": "object"
}
