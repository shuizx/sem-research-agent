{
  "$defs": {
    "HumanText": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "ReasonCode": {
      "pattern": "^[A-Z0-9]+(?:_[A-Z0-9]+){2,}$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Stable reason code with optional bounded human explanation.",
  "properties": {
    "code": {
      "$ref": "#/$defs/ReasonCode"
    },
    "message": {
      "anyOf": [
        {
          "$ref": "#/$defs/HumanText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "code"
  ],
  "title": "Reason",
  "type": "object"
}
