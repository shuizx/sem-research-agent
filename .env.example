# Copy this file to .env only if .env does not exist. Never commit the copied file.
# Default/legacy DashScope settings:
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
VRO_LLM_MODEL=qwen-plus
VRO_DATASET_ROOT=
VRO_DATASET_PROFILE=

# For a custom OpenAI-compatible gateway, replace the model above and uncomment:
# VRO_LLM_BASE_URL=https://claw.shu.edu.cn/api/v1
# VRO_LLM_API_KEY=replace-with-your-shu-api-key
# VRO_LLM_MODEL=Qwen3.8-MAX
# The legacy DASHSCOPE_API_KEY is NEVER used for a custom endpoint.
